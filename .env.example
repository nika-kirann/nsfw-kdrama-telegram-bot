# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=
# Channel to post episodes to: @channelusername or numeric -100... id (bot must be channel admin)
CHANNEL_ID=
# Optional: comma-separated Telegram user IDs allowed to use /post
ADMIN_IDS=
# Optional
TIMEZONE=Asia/Kolkata
DAILY_DIGEST_TIME=21:00
BRAND=
DATA_FILE=data/series.json

# --- Channel-as-database (heaven-bot style) ---
# local = data/series.json only; telegram = mirror it to a private DB channel (needed on Koyeb)
STORAGE_BACKEND=local
# Private channel where the bot is admin (post/edit/delete/PIN). Separate from the public CHANNEL_ID.
DB_CHANNEL_ID=
STORAGE_FLUSH_DELAY=3
# Set by Koyeb; starts the /healthz server. Leave empty locally.
PORT=
